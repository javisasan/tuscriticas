<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd    ">
    <entity name="CommonPlatform\Context\App\Domain\Entity\User" table="users">
        <id name="id" type="string" column="id" length="36" nullable="false" />
        <field name="email" type="string" column="email" length="128" nullable="false" />
        <field name="password" type="string" column="password" length="128" nullable="false" />
        <field name="roles" type="json" column="roles" nullable="true" />

        <indexes>
            <index name="user_id_idx" columns="email"/>
        </indexes>
    </entity>
</doctrine-mapping>
